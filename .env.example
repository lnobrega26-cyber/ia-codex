# Backend only. Não publiques valores reais destas variáveis.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_SSL=true
CODEX_JWT_SECRET=replace-with-a-long-random-secret
PORT=3000

# Exemplo de chave do fornecedor. Adiciona outras chaves com nomes diferentes.
OPENAI_API_KEY=

# Catálogo JSON; custos são créditos internos por 1.000 tokens de entrada/saída.
# O modelo gratuito custa zero créditos ao utilizador, mas o fornecedor pode cobrar ao operador.
CODEX_MODELS=[{"id":"codex-free","name":"CODEX Free","provider":"OpenAI","model":"gpt-4o-mini","apiBase":"https://api.openai.com/v1","apiKeyEnv":"OPENAI_API_KEY","inputCostPer1k":0,"outputCostPer1k":0,"free":true,"description":"Modelo gratuito em créditos para conversas do dia a dia."}]
